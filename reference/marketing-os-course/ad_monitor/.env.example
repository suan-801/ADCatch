# ad-monitor 독립 스킬 — 전용 자격증명 파일 템플릿
# 실제 값을 채운 뒤 파일명을 `.env` 로 저장하세요 (`.env` 는 절대 커밋 ❌).
# ★ 이 파일은 Claudecode_MarketingOS_student 프로젝트의 `09_tracking/.env` 와 완전히 별개입니다.
#   (같은 값을 재사용해도 되지만, 이 스킬은 반드시 이 파일 하나만 읽습니다.)

# ============================================================
# Apify — 메타 광고 라이브러리 크롤링 (필수)
# ============================================================
# 발급: https://console.apify.com/settings/integrations
# 액터 1회 활성화 필요: https://apify.com/curious_coder/facebook-ads-library-scraper
APIFY_TOKEN=apify_api_...

# (선택) 다른 액터 쓸 때 변경
# APIFY_ACTOR=curious_coder~facebook-ads-library-scraper

# ============================================================
# Gemini — 광고 소재 USP 3항목 분석 (없으면 --no-gemini 로 수집만 가능)
# ============================================================
# 발급: https://aistudio.google.com/apikey
# ★ 2026년 새로 발급하는 키는 AIza 가 아니라 AQ 로 시작합니다.

# 무료 티어 (결제 미연결, 250 RPD 한도) — 디폴트로 사용
GEMINI_API_KEY_FREE=AQ...

# (선택) 유료 티어 — --paid 플래그 사용 시
GEMINI_API_KEY_PAID=

# (선택) 둘 다 없을 때의 단일 키 폴백
GEMINI_API_KEY=

# (선택) 다른 모델 쓸 때 변경
# GEMINI_MODEL=gemini-3.6-flash
