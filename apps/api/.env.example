# ADCatcher API — 환경 변수 템플릿
# 이 파일을 복사해 .env 로 저장한 뒤 실제 값으로 채우세요: cp .env.example .env
# .env 는 절대 git에 커밋하지 마세요 (.gitignore 에 이미 등록됨).

# ── Database (PostgreSQL / Supabase) ──────────────────────────────
# Supabase 대시보드 → Project Settings → Database → Connection String → "Session pooler" 탭에서 복사
# (SQLAlchemy가 psycopg3 드라이버를 쓰도록 postgresql+psycopg:// 스킴 사용, DB 이름은 항상 postgres 고정)
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# ── Storage (썸네일 캐싱 — Meta CDN 링크 만료 대비, 아직 미구현 — 준비만 해두는 값) ──
# SUPABASE_URL: Project Settings → Data API → Project URL
# SUPABASE_SERVICE_KEY: Project Settings → API Keys → Secret keys (sb_secret_...). 절대 프론트엔드에 넣지 말 것
# SUPABASE_STORAGE_BUCKET: Storage → New bucket 에서 직접 만든 버킷 이름 (Public 권장)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SECRET_KEY
SUPABASE_STORAGE_BUCKET=ad-thumbnails

# ── Meta Ad Library 수집 (Apify) ──────────────────────────────────
# 1) https://console.apify.com/settings/integrations 에서 API 토큰 발급
# 2) https://apify.com/curious_coder/facebook-ads-library-scraper 액터 1회 활성화(Try for free 클릭)
APIFY_TOKEN=apify_api_YOUR_TOKEN_HERE
APIFY_ACTOR=curious_coder/facebook-ads-library-scraper

# ── Vision AI Tagging (Gemini) ────────────────────────────────────
# https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.6-flash

# ── Microsoft Teams 알림 ──────────────────────────────────────────
# 옛 "커넥터(Incoming Webhook)"는 2026-05 폐지됨 — 채널 ··· → Workflows →
# "Post to a channel when a webhook request is received" 템플릿으로 생성 후 나오는 URL
TEAMS_WEBHOOK_URL=https://YOUR_REGION.logic.azure.com/workflows/YOUR_WORKFLOW_ID/triggers/manual/paths/invoke?...

# ── 기타 ───────────────────────────────────────────────────────────
# 14일 자동 정지 정책의 기준 admin 계정 (MVP: 로그인 없이 고정 사용)
DEFAULT_ADMIN_EMAIL=admin@company.com

# ── Viewer/Admin 권한 ────────────────────────────────────────────────
# 사이트 기본 방문자는 Viewer(읽기 전용)이고, 아래 비밀번호로 인증에 성공한 브라우저만
# 프로젝트/브랜드 생성·삭제·수집 실행 등 관리 기능을 쓸 수 있다.
#
# ADMIN_PASSWORD_HASH: 원본 비밀번호를 절대 여기 넣지 말 것 — bcrypt hash만 저장한다.
#   생성: cd apps/api && python -m scripts.hash_admin_password
ADMIN_PASSWORD_HASH=
# ADMIN_SESSION_SECRET: 세션 쿠키 서명용 랜덤 키. 비어 있으면 Admin 로그인이 비활성화된다.
#   생성: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SESSION_SECRET=
# Admin 세션 유효 시간 (시간 단위)
ADMIN_SESSION_TTL_HOURS=8
# 로컬 개발(frontend/backend가 둘 다 localhost)은 lax + false로 충분하다.
# frontend(Vercel)와 backend가 서로 다른 도메인인 운영 배포에서는 none + true로 바꿔야 한다.
ADMIN_COOKIE_SAMESITE=lax
ADMIN_COOKIE_SECURE=false

# ── Campaign Tag 자동 분류 (2026-09, 선택 — 기본값이 코드에 있어 필수 아님) ────────
# Gemini confidence가 이 값보다 낮으면 자동 확정하지 않고 NEEDS_REVIEW로 남긴다.
CAMPAIGN_TAG_CONFIDENCE_THRESHOLD=0.6
CAMPAIGN_CLASSIFICATION_PENDING_BATCH_SIZE=20
CAMPAIGN_CLASSIFICATION_MAX_RETRIES=3

# ── 성능 최적화 (2026-09, 선택) ───────────────────────────────────────────
# last_accessed_at 갱신을 이 초(秒) 단위로만 DB에 반영한다(요청마다 write하지 않기 위함).
# 14일 자동 정지 정책의 의미에는 영향 없다 — docs/DATA_SEMANTICS.md §7 참고.
LAST_ACCESSED_TOUCH_THROTTLE_SECONDS=300
