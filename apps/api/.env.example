# AdCatch API — 환경 변수 템플릿
# 이 파일을 복사해 .env 로 저장한 뒤 실제 값으로 채우세요: cp .env.example .env
# .env 는 절대 git에 커밋하지 마세요 (.gitignore 에 이미 등록됨).

# ── Database (PostgreSQL / Supabase) ──────────────────────────────
# Supabase 프로젝트 생성 후 Project Settings → Database → Connection string 에서 확인
# (SQLAlchemy가 psycopg3 드라이버를 쓰도록 postgresql+psycopg:// 스킴 사용)
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/adcatch

# ── Storage (썸네일 캐싱 — Meta CDN 링크 만료 대비) ──────────────────
# Supabase 프로젝트 생성 후 Project Settings → API 에서 확인 (S3 대신 Supabase Storage 사용 — 별도 AWS 계정 불필요)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=ad-thumbnails

# ── Meta Ad Library 수집 (Apify) ──────────────────────────────────
# 1) https://console.apify.com/settings/integrations 에서 API 토큰 발급
# 2) https://apify.com/curious_coder/facebook-ads-library-scraper 액터 1회 활성화(Try for free 클릭)
APIFY_TOKEN=apify_api_YOUR_TOKEN_HERE
APIFY_ACTOR=curious_coder/facebook-ads-library-scraper

# ── Vision AI Tagging (Gemini) ────────────────────────────────────
# https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.6-flash

# ── Microsoft Teams 알림 ──────────────────────────────────────────
# Teams 채널 → 커넥터(Incoming Webhook) 추가 후 발급되는 URL
TEAMS_WEBHOOK_URL=https://YOUR_TENANT.webhook.office.com/webhookb2/YOUR_WEBHOOK_PATH

# ── 기타 ───────────────────────────────────────────────────────────
# 14일 자동 정지 정책의 기준 admin 계정 (MVP: 로그인 없이 고정 사용)
DEFAULT_ADMIN_EMAIL=admin@company.com
